# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# Never commit `.env`. Never paste a key into a chat, an issue, a prompt, or a
# commit message. If one leaks, revoke it at the provider and issue a new one —
# rotating is cheap, an exposed key is not.

# ---------------------------------------------------------------------------
# LLM provider — used by the upstream Analytics Agent (manual mode) and by our
# auto-mode agent. See .tasks/mvp/TASKS.md, task H1.
# ---------------------------------------------------------------------------

# One of: local | google | anthropic | openai | bedrock | openai-compatible
LLM_PROVIDER=local

# Optional: pin a specific model rather than the provider default.
# **Both benchmark arms must use the same model.** That is a fairness requirement,
# not a preference — agent_datahub and agent_raw differ in catalog context alone.
LLM_MODEL=qwen/qwen3.6-35b-a3b

# ---------------------------------------------------------------------------
# LLM_PROVIDER=local — inference on this machine via LM Studio
# ---------------------------------------------------------------------------
# The default, and the one that needs no key, no quota, and no network. A judge
# can clone this repository and reproduce the whole benchmark for free, which is
# a stronger claim than asking them to trust our numbers.
#
#   lms server start          # serves an OpenAI-compatible API on :1234
#   lms ls                    # what is downloaded
#
# Model settings are part of the experimental setup: use the same context length,
# quantisation and offload for both arms, and tick "Remember settings" in LM Studio
# so a rerun is the same experiment. Context must be 32k or more — a busy turn runs
# to ~27k tokens, and at 8k the model silently loses the query results it was
# reasoning about, which looks like a stupid model rather than a starved one.
LLM_BASE_URL=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# LLM_PROVIDER=google — hosted Gemini
# ---------------------------------------------------------------------------
# Google AI Studio key, starts with AIza. Get one at https://aistudio.google.com/apikey
# A free-tier key cannot run this benchmark: a scored run is ~216 calls per arm and
# the daily quota dies long before that. Billing must be enabled. See
# .tasks/mvp/SLICE6-HANDOFF.md for what was measured.
GOOGLE_API_KEY=

# Seconds to hold between requests, to stay under a per-minute rate limit. Only
# meaningful for hosted providers; 0 for local, where it is pure waiting.
LLM_MIN_INTERVAL=0

# ---------------------------------------------------------------------------
# Local services. These match infra/postgres/docker-compose.yml and the DataHub
# quickstart, and are not secrets — auth is off by design (docs/DECISIONS.md).
# Override only if you moved something off its default port.
# ---------------------------------------------------------------------------

BLINDCITY_WAREHOUSE_URL=postgresql+psycopg://blindcity:blindcity@localhost:5432/blindcity
BLINDCITY_DATAHUB_GMS_URL=http://localhost:8080
BLINDCITY_CONTROL_URL=http://localhost:8000
