# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# Never commit `.env`. Never paste a key into a chat, an issue, a prompt, or a
# commit message. If one leaks, revoke it at the provider and issue a new one --
# rotating is cheap, an exposed key is not. That includes commented-out keys: a
# `#` in front of a credential hides it from the parser, not from anyone reading
# the file.
#
# Define every variable EXACTLY ONCE. `config.load_dotenv` is first-wins, so a
# duplicate silently shadows the later one. This has already cost real debugging
# time: a stale `LLM_PROVIDER=local` near the top kept overriding an
# `LLM_PROVIDER=openai` added at the bottom, and the run went to the wrong host.

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
# Used by our auto-mode agent (both benchmark modes) and by the upstream
# Analytics Agent in manual mode.
#
#   openai  hosted OpenAI API
#   local   an OpenAI-compatible server you run: LM Studio, llama.cpp, vLLM,
#           Ollama. No key, no quota, no network -- and a judge can reproduce
#           the whole benchmark from a clone, which is a stronger claim than
#           asking them to trust our numbers.
#   google  Gemini
#
# `openai` and `local` share one client and differ only in LLM_BASE_URL and
# whether the key is real.
LLM_PROVIDER=local

# Must match LLM_PROVIDER.
#   openai -> https://api.openai.com/v1
#   local  -> http://localhost:1234/v1   (LM Studio default; `lms server start`)
#   google -> leave unset, the client has its own endpoint
LLM_BASE_URL=http://localhost:1234/v1

# **BOTH BENCHMARK MODES MUST USE THE SAME MODEL.** A fairness requirement, not a
# preference: agent_datahub and agent_raw differ in catalog context alone.
#
# Verify the id against the provider's own model list before a scored run rather
# than trusting a name written here. Availability has moved under this project
# twice: `gemini-2.5-flash` began returning 404 "no longer available to new
# users" while still appearing in the models listing, and every `pro` model
# returned 429 on a free tier.
LLM_MODEL=

# Seconds held between requests, for hosted per-minute rate limits. Firing a
# turn's tool calls back to back trips them within seconds, and retrying inside
# the same minute cannot clear it. Use 0 for local inference and for a paid
# tier, where it is pure waiting.
LLM_MIN_INTERVAL=0

# How long the model may take to answer one call, in seconds. This is a THINKING BUDGET, not an
# infrastructure timeout, and it is deliberately generous: a reasoning model can spend minutes on
# a single reply, and cutting it off would not measure the model, it would measure our patience.
#
# Keep it distinct from the timeouts that guard resources -- the 45s cap on any single SQL query,
# the 15s lock wait during cleanup, the 30s catalog fetch. Those are tight because a database or
# an HTTP read should never be slow. Shortening the one below instead silently handicaps the
# thing being benchmarked.
LLM_TIMEOUT=900

# ---------------------------------------------------------------------------
# Credentials. One per provider; leave the others empty.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai, or any OpenAI-compatible gateway. OPENAI_API_KEY is also
# accepted as a fallback, since that is the name the provider's tooling uses.
LLM_API_KEY=

# LLM_PROVIDER=google. Google AI Studio: https://aistudio.google.com/apikey
#
# A free-tier key cannot run this benchmark. A scored run is roughly 216 calls
# per mode, per seed, and the daily quota dies long before that -- measured, see
# .tasks/mvp/SLICE6-HANDOFF.md. Billing must be enabled.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Local services. These match infra/postgres/docker-compose.yml and the DataHub
# quickstart, and are not secrets -- auth is off by design (docs/DECISIONS.md).
# Override only if you moved something off its default port.
#
# Bring them up with:  powershell -ExecutionPolicy Bypass -File infra/stack.ps1
# ---------------------------------------------------------------------------
BLINDCITY_WAREHOUSE_URL=postgresql+psycopg://blindcity:blindcity@localhost:5432/blindcity
BLINDCITY_DATAHUB_GMS_URL=http://localhost:8080
BLINDCITY_CONTROL_URL=http://localhost:8000

# How hard the model may think per reply: minimal | low | medium | high.
# Set explicitly because it is a property of what the benchmark measures, and every mode gets the
# same value. Defaults to low.
LLM_REASONING_EFFORT=low
